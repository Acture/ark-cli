[package]
name = "ark-battle-runtime-probe"
version = "0.1.0"
edition = "2021"
rust-version = "1.89"
license = "MIT OR Apache-2.0"
publish = false
description = "Windows x64 no-CRT Unity preloaded plugin for the original battle implementation."

[lib]
path = "src/battle-probe.rs"
crate-type = ["cdylib"]
test = false
doctest = false
bench = false

# The DLL needs panic=abort and no CRT; keep these profiles out of the battle runtime.
[workspace]

[profile.dev]
panic = "abort"

[profile.release]
panic = "abort"
opt-level = 2

[lints.rust]
warnings = "deny"
